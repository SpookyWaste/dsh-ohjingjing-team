{
  "name": "dsh-ohjingjing-team",
  "version": "0.4.1",
  "description": "DSH 的哦鲸鲸主题：成员行皮肤 + 标题栏跑道 + 子代理列表，三块组件可分别开关。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-team",
    "theme",
    "ohjingjing"
  ],
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skin": {
      "types": "./lib/skin.d.ts",
      "default": "./lib/skin.js"
    },
    "./runners": {
      "types": "./lib/runners.d.ts",
      "default": "./lib/runners.js"
    },
    "./catalog": {
      "types": "./lib/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./client": "./client.js",
    "./skin/locale/*": "./locale/skin/*",
    "./runners/locale/*": "./locale/runners/*",
    "./catalog/locale/*": "./locale/catalog/*",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "lib",
    "locale",
    "assets/*.png",
    "assets/manifest.assets.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "gen": "node tools/gen-client.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/run-tests.mjs",
    "preview": "node tools/build-preview.mjs && node tools/build-contact-sheet.mjs",
    "compare": "node tools/build-loop-compare.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
